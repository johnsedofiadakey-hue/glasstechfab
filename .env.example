# ─── FIREBASE (public — safe to commit) ───────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── ADMIN BOOTSTRAP (never commit real values) ───────────────────────────────
# Firebase Auth UIDs of admin users — used to set role:'admin' on first run only.
# Remove these after initial seed; use role-based Firestore rules going forward.
VITE_ADMIN_UID_1=
VITE_ADMIN_UID_2=

# ─── SEED / DEMO PASSWORDS (never commit real values) ─────────────────────────
# Used only for local dev seeding. NEVER set in production.
VITE_SEED_CLIENT_PASSWORD=
VITE_DEMO_PASSWORD=

# ─── PAYSTACK (public key is safe client-side) ────────────────────────────────
VITE_PAYSTACK_PUBLIC_KEY=

# ─── WHATSAPP / SMS (SECRET — store in Firebase Secrets Manager, not here) ────
# These are referenced in Cloud Functions via defineSecret(), NOT in the client.
# Do NOT prefix with VITE_ — they must never reach the browser bundle.
# Set via: firebase functions:secrets:set ARKESEL_API_KEY
ARKESEL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
WHATSAPP_PROVIDER=   # arkesel | twilio | meta

# ─── ANTHROPIC / AI (SECRET — Cloud Functions only) ───────────────────────────
ANTHROPIC_API_KEY=

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
VITE_APP_URL=https://glasstech.com.gh
