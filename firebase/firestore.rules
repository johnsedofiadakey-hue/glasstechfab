rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Block all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── HELPER FUNCTIONS ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasEmail() {
      return isAuthenticated() && 'email' in request.auth.token && request.auth.token.email != null;
    }

    // Role-field check (primary, most secure). Falls back to email allowlist.
    // Set role:'admin' in /users/{uid} via Admin SDK to grant admin access.
    function isAdminByRole() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Email allowlist (legacy fallback — migrate to role-based over time)
    function isAdminByEmail() {
      return hasEmail() && (
        request.auth.token.email.matches(".*@glasstechfab.com") ||
        request.auth.token.email.matches(".*@stormglide.com") ||
        request.auth.token.email == "contact@glasstech.com.gh" ||
        request.auth.token.email == "glasstechfabrications@gmail.com"
      );
    }

    function isAdmin() {
      return isAdminByRole() || isAdminByEmail();
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff';
    }

    function isWorker() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'worker';
    }

    function isAdminOrStaff() {
      return isAdmin() || isStaff() || isWorker();
    }

    // Firebase Phone Auth: request.auth.token.phone_number is E.164 (+233244...)
    // Our clientId is normalized without leading + (233244...)
    function phoneMatchesClientId(clientId) {
      return 'phone_number' in request.auth.token &&
             request.auth.token.phone_number != null &&
             request.auth.token.phone_number == ('+' + clientId);
    }

    function isClient(clientId) {
      return isAuthenticated() && phoneMatchesClientId(clientId);
    }

    // Validate that a write only sets allowed fields (prevents mass-assignment)
    function hasOnly(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ─── USER PROFILES ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow get: if isAdminOrStaff() || (isAuthenticated() && (request.auth.uid == userId || isClient(userId)));
      allow list: if isAdminOrStaff();
      // Users can update their own non-privileged fields only
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        !('role' in request.resource.data) &&
        !('status' in request.resource.data)
      );
      allow create, delete: if isAdmin();
    }

    // ─── TEAM (staff metadata) ──────────────────────────────────────────────────
    match /team/{memberId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // ─── OPERATIONS ────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdminOrStaff();
    }
    match /assets/{assetId} {
      allow read: if isAdminOrStaff();
      allow write: if isAdmin();
    }

    // ─── PROJECTS & CLIENT DATA ─────────────────────────────────────────────────
    match /projects/{projectId} {
      allow get: if isAdminOrStaff() || isClient(resource.data.clientId);
      // Clients may list — the app always queries where('clientId','==',theirId)
      allow list: if isAdminOrStaff() || (
        isAuthenticated() &&
        'phone_number' in request.auth.token &&
        request.auth.token.phone_number != null
      );
      allow write: if isAdminOrStaff();
      // Clients may approve their own quotation (restricted field set only)
      allow update: if isClient(resource.data.clientId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['quoteApproved', 'quoteApprovedAt', 'stageId', 'status', 'stageHistory', 'updatedAt']);

      // Sub-collections: messages, approvals, documents, etc.
      match /messages/{msgId} {
        allow get, list: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        // Clients may only create messages with allowed fields
        allow create: if (
          isAdminOrStaff() ||
          (isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId) &&
           hasOnly(['text', 'sender', 'senderName', 'type', 'timestamp', 'projectId', 'fileUrl', 'fileName']))
        );
        allow update, delete: if isAdmin();
      }

      match /approvals/{approvalId} {
        allow get, list: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow create: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow update, delete: if isAdmin();
      }

      match /documents/{docId} {
        allow get, list: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow create: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow update, delete: if isAdmin();
      }

      // Fallback for any other sub-collection
      match /{subcollection}/{docId} {
        allow get, list: if isAdminOrStaff() || isClient(get(/databases/$(database)/documents/projects/$(projectId)).data.clientId);
        allow write: if isAdminOrStaff();
      }
    }

    // ─── BOOKINGS, PROPOSALS ───────────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isAdminOrStaff();
      allow create: if isAuthenticated() && hasOnly(['name','email','phone','date','slot','message','service','createdAt','status']);
    }
    match /proposals/{proposalId} {
      allow read: if isAdminOrStaff() || isClient(resource.data.clientId);
      allow write: if isAdmin();
    }

    // ─── CMS & SETTINGS ────────────────────────────────────────────────────────
    match /cms_content/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{docId}    { allow read: if true; allow write: if isAdmin(); }

    // ─── NOTIFICATIONS ─────────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          isClient(resource.data.userId)
        )
      );
      // Only admin/staff/Cloud Functions (via Admin SDK) may create notifications
      allow create: if isAdminOrStaff();
      allow update, delete: if isAdmin() || (
        isAuthenticated() && (
          request.auth.uid == resource.data.userId ||
          isClient(resource.data.userId)
        )
      );
    }

    // ─── PUBLIC CONTENT ────────────────────────────────────────────────────────
    match /portfolio/{projId}    { allow read: if true; allow write: if isAdmin(); }
    match /products/{prodId}     { allow read: if true; allow write: if isAdmin(); }
    match /testimonials/{testId} {
      allow read: if true;
      allow create: if isAuthenticated() && hasOnly(['author','text','rating','projectTitle','createdAt','approved']);
      allow update, delete: if isAdmin();
    }
    match /showcase/{sceneId}    { allow read: if true; allow write: if isAdmin(); }

    // ─── MESSAGING ─────────────────────────────────────────────────────────────
    match /messages/{msgId} {
      allow read: if isAdminOrStaff() || (isAuthenticated() && (
        request.auth.uid == resource.data.senderId ||
        request.auth.uid == resource.data.receiverId ||
        isClient(resource.data.senderId) ||
        isClient(resource.data.receiverId)
      ));
      allow create: if isAuthenticated() && hasOnly(['text','sender','senderName','receiverId','projectId','type','timestamp','fileUrl','fileName','read']);
      allow update: if isAdminOrStaff() || (isAuthenticated() && request.auth.uid == resource.data.senderId);
      allow delete: if isAdmin();
    }

    // ─── EMAILS ────────────────────────────────────────────────────────────────
    match /emails/{emailId} {
      allow read: if isAdmin() || (hasEmail() && request.auth.token.email == resource.data.to);
      allow write: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ─── OPERATIONS (admin/staff only) ─────────────────────────────────────────
    match /work_orders/{id}      { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }
    match /containers/{id}       { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdmin(); }
    match /transactions/{id}     { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdmin(); }
    match /invoices/{id}         { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdmin(); }
    match /tasks/{id}            { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }
    match /procurements/{id}     { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }
    match /activity_logs/{id}    { allow read: if isAdminOrStaff(); allow write: if isAdminOrStaff(); }
    match /approvals/{id}        { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdmin(); }
    match /change_requests/{id}  { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow create: if isAuthenticated(); allow update, delete: if isAdmin(); }
    match /notes/{id}            { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }
    match /media/{id}            { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }
    match /shipments/{id}        { allow read: if isAdminOrStaff() || isClient(resource.data.clientId); allow write: if isAdminOrStaff(); }

    // ─── RATE-LIMIT TRACKING (Cloud Functions write only) ─────────────────────
    match /rate_limits/{id} {
      allow read, write: if false; // Admin SDK only
    }
  }
}
